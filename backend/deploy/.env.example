# 复制为服务器 .env，权限必须为 600；所有密钥填写随机强密码。
DEPLOY_ENV=test
API_PORT=8013
GATEWAY_NETWORK=weishen-test_default
APP_ENV=staging
PUBLIC_BASE_URL=https://test-www.qhzhiyin.com/yingji
CORS_ORIGINS=https://test-www.qhzhiyin.com
REDIS_ADDR=填写现有Redis内网地址:6379
REDIS_DB=5
JWT_SECRET_MP=
JWT_SECRET_ADMIN=
SIGN_SECRET=
ADMIN_INIT_USER=admin
ADMIN_INIT_PASSWORD=
STORAGE_DRIVER=oss
OSS_REGION=cn-beijing
OSS_BUCKET=
OSS_PREFIX=yingji/test
OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
GEN_PROVIDER_DEFAULT=newapi
GEN_CONCURRENCY=1
NEWAPI_BASE_URL=https://www.ggwk1.online/v1
NEWAPI_MODEL=gpt-image-2.5
NEWAPI_API_KEY=
# 测试可使用 mock；生产须用 tencent 或 disabled，绝不使用模拟人脸校验。
FACE_PROVIDER=mock
WECHAT_APPID=
WECHAT_SECRET=

# PostgreSQL 内网连接；密码中的特殊字符需 URL 编码。
DATABASE_URL=postgres://账号:密码@地址:5432/yingji_test?sslmode=disable
DB_MAX_OPEN=2
DB_MAX_IDLE=0
REDIS_USERNAME=
REDIS_PREFIX=yingji:test:
REDIS_PASSWORD=
