APP_ENV=dev
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5175

MYSQL_DSN=root:@tcp(127.0.0.1:3306)/yingji?parseTime=true&loc=UTC&charset=utf8mb4
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

JWT_SECRET_MP=change-me
JWT_SECRET_ADMIN=change-me-too
SIGN_SECRET=change-me-three

# WeChat (leave empty in dev: login uses the h5_dev provider)
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_AD_CALLBACK_SECRET=
WECHAT_SUBSCRIBE_TASK_FINISHED=
WECHAT_REWARD_AD_UNIT_ID=

# Storage: local (served at /files) or cos
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/objects
COS_BUCKET_URL=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_CDN_HOST=

# Vision: mock | tencent
FACE_PROVIDER=mock
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# Gen model: mock | volcengine
GEN_PROVIDER_DEFAULT=mock
GEN_CONCURRENCY=4
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL=doubao-seedream-4-0-250828

POSTER_FONT_PATH=
ADMIN_INIT_USER=admin
ADMIN_INIT_PASSWORD=admin123

# 阿里云 OSS：测试与生产必须使用不同前缀，公网签名与内网上传端点分开。
OSS_REGION=cn-beijing
OSS_BUCKET=
OSS_PREFIX=yingji/dev
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# NewAPI 图像编辑：启用时设置 GEN_PROVIDER_DEFAULT=newapi，密钥只放后端。
NEWAPI_BASE_URL=https://www.ggwk1.online/v1
NEWAPI_MODEL=gpt-image-2.5
NEWAPI_API_KEY=
MYSQL_MAX_OPEN=5
MYSQL_MAX_IDLE=1
